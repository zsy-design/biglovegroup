 * @param n int整型 
 * @return int整型
 */
int factorialOfN(int n ) {
    // write code here
    long long jiecheng=1;
    int mo=1000000007;
    for(int i=n;i>=1;i--){
        jiecheng= jiecheng*i%mo;

    }
    return jiecheng;

}
