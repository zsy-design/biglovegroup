#include <stdio.h>

int main() {
    int a;
    scanf("%d",&a);
    int b[1000];
    b[0]=0;
    b[1]=1;
    b[2]=1;
    for(int i=3;i<=a;i++){
        b[i]=b[i-1]+2*b[i-2]+b[i-3];
    }
    printf("%d",b[a-1]);
    return 0;
}


