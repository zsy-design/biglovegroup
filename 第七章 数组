#include <stdio.h>
int b[100005]; 
int main() {
    int a;
    scanf("%d", &a);
    for(int i = 0; i < a; i++){
        scanf("%d", &b[i]);
    }
    
   
    for(int j = 0; j < a; j++){
        int count = 0; 
        
        
        for(int k = 0; k < j; k++){
            if(b[k] < b[j]){ 
                count++;     
            }
        }
        
        printf("%d ", count); 
    }

    return 0;
}//参考了下deepseek



