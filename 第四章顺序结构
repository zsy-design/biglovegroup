#include <stdio.h>

int main() {
    int a;
    scanf("%d",&a);

    if(a>=1000 && a<=9999){
        int qian = a / 1000;        //千位
        int bai  = a / 100 % 10;    //百位
        int shi  = a / 10 % 10;     //十位
